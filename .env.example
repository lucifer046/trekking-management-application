# Copy this file to `.env` for local development. `.env` is gitignored —
# never commit real secrets. config.py loads this automatically via
# python-dotenv; in production, set these as real environment variables
# instead of shipping a .env file.

# Flask environment: development | testing | production
FLASK_ENV=development

# Long, random string used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-me

# Optional — defaults to a local SQLite file under instance/ if unset.
# DATABASE_URL=sqlite:///instance/trekking.db

# Bootstrap admin account, used by `flask create-admin` and `seed.py`.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@trekking.com
ADMIN_PASSWORD=Admin@12345
